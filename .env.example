# Copy to .env and fill in values from LINE Developers console
LINE_CHANNEL_SECRET=your_channel_secret_here
LINE_CHANNEL_ACCESS_TOKEN=your_channel_access_token_here
# Comma-separated LINE user IDs allowed to use the bot (empty = allow all).
# Find your user ID in the webhook event JSON ("source": {"userId": "U..."}).
LINE_ALLOWED_USER_IDS=Uxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
PORT=8000
# Local storage for history log + pending answers
DATA_DIR=./data
# Seconds to wait for generation before sending the ask-again notice
SLOW_THRESHOLD_SECONDS=25
# Keyword to fetch a parked (pending) answer without re-running generation
FETCH_KEYWORD=繼續
# Artificial generation delay (seconds) to exercise the slow path; 0 = off
DEBUG_SLOW_SECONDS=0
# LLM agent (Phase 2): true = reply via OpenRouter agent, false = echo stub
AGENT_ENABLED=true
OPENROUTER_API_KEY=sk-or-xxxxxxxxxxxxxxxx
# Bare slugs accepted with or without the "openrouter:" prefix
LLM_MODEL=qwen/qwen3-next-80b-a3b-instruct:free
LLM_FALLBACK_MODEL=openrouter/free
